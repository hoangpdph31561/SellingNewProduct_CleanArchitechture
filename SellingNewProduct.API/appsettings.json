{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "SqlServer",
  "MongoDatabaseName": "SellingNewProduct",
  // Messaging is wired only for the Saga/Hybrid provider. Kafka = event backbone (durable,
  // replayable, fan-out); RabbitMQ = command/work queue (per-message ack, retry, dead-letter).
  // Run both locally with docker-compose.messaging.yml. If a broker is down the app still starts:
  // the outbox retries publishing and the consumers reconnect. See docs/outbox-kafka-rabbitmq.md.
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "selling-newproduct"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "MaxRetries": 3
  },
  // Downstream gateways behind the RabbitMQ command workers. UseReal=false keeps the logging
  // stand-ins so the app runs with no credentials; set true to send real email (SMTP) and write
  // real PDF invoices. Either way the command worker calls them through the Polly circuit breaker.
  "Gateways": {
    "UseReal": false,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "User": "",
      "Password": "",
      "FromAddress": "no-reply@sellingnewproduct.local",
      "FromName": "SellingNewProduct"
    },
    "Invoice": {
      "OutputDirectory": "invoices",
      "SellerName": "SellingNewProduct JSC",
      "SellerTaxCode": "0100000000",
      "SellerAddress": "123 Le Loi, District 1, Ho Chi Minh City"
    }
  },
  // VNPay merchant config. TmnCode/HashSecret are issued by VNPay — DO NOT commit real secrets;
  // use user-secrets or environment variables. BaseUrl defaults to the sandbox pay endpoint.
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "https://localhost:5001/api/payments/vnpay-return",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "ExpireMinutes": 15
  },
  "ConnectionStrings": {
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=SellingNewProduct;Trusted_Connection=True;TrustServerCertificate=True",
    // Hybrid/Saga provider only (DatabaseProvider=Hybrid): Order/Payment + the SagaTransactions
    // ledger live in this SEPARATE database, while the catalogue/people live in MongoDB. The saga
    // gives each side a REAL local transaction (SQL + Mongo) and uses compensation only for the
    // single cross-DB window — so the Mongo connection below MUST point at a REPLICA SET.
    "SqlServerSaga": "Server=(localdb)\\MSSQLLocalDB;Database=SellingNewProduct_Saga;Trusted_Connection=True;TrustServerCertificate=True",
    // Split read/write across replica-set nodes (SAME database):
    //   "MongoDB"     = WRITE → PRIMARY     (writes + transactions must hit the primary).
    //   "MongoDBRead" = READ  → SECONDARY   (read repositories prefer secondaries; falls back to
    //                                        primary on a 1-node set or if no secondary is alive).
    // On the 1-node set (docker-compose.mongo-rs.yml) secondaryPreferred just reads the only node.
    // For the 3-node cluster (docker-compose.mongo-rs-3node.yml): add
    //   "127.0.0.1 mongo1 mongo2 mongo3" to your hosts file (see docs/mongo-replica-set.md) and
    // swap BOTH values for the 3-seed strings:
    //   "MongoDB":     "mongodb://mongo1:27017,mongo2:27018,mongo3:27019/?replicaSet=rs0&readPreference=primary"
    //   "MongoDBRead": "mongodb://mongo1:27017,mongo2:27018,mongo3:27019/?replicaSet=rs0&readPreference=secondaryPreferred"
    "MongoDB": "mongodb://localhost:27017/?replicaSet=rs0&readPreference=primary",
    "MongoDBRead": "mongodb://localhost:27017/?replicaSet=rs0&readPreference=secondaryPreferred"
  }
}
