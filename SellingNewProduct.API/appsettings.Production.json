{
  // PRODUCTION overrides. Nothing here points at localhost — telemetry is PUSHED to a collector and
  // the app binds to whatever the host/orchestrator provides (ASPNETCORE_URLS / reverse proxy).
  //
  // Secrets (connection strings, JWT SigningKey, SMTP/VNPay) MUST come from environment variables or a
  // secret manager, NOT this file. Env var form uses "__" as the nesting separator, e.g.:
  //   OpenTelemetry__OtlpEndpoint=http://otel-collector:4317
  //   ConnectionStrings__SqlServerSaga=...
  //   Jwt__SigningKey=...
  "OpenTelemetry": {
    "ServiceName": "SellingNewProduct.API",
    // OTel Collector endpoint (service DNS in the cluster, NOT localhost). Traces + metrics push here;
    // the collector fans out to Jaeger/Tempo (traces) and Prometheus/Loki (metrics/logs).
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "FileLogging": {
    // A mounted volume so a log shipper (Promtail/Filebeat) collects JSON logs into Loki/ELK.
    "Directory": "/var/log/sellingnewproduct",
    "RetainedFileCountLimit": 30
  }
}
