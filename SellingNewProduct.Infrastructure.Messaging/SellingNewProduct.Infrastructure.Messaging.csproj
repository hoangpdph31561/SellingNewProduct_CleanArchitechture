<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kafka = the durable, replayable event backbone (many consumer groups). -->
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
    <!-- RabbitMQ = the command/work queue (per-message ack, retry, dead-letter). -->
    <PackageReference Include="RabbitMQ.Client" Version="7.0.0" />
    <!-- Polly = resilience pipelines (timeout + retry + circuit breaker) around downstream gateways. -->
    <PackageReference Include="Polly.Extensions" Version="8.5.0" />
    <!-- Polly.RateLimiting = the bulkhead (concurrency limiter) strategy that isolates each worker's
         in-flight calls so one slow gateway cannot starve the whole thread/connection pool. -->
    <PackageReference Include="Polly.RateLimiting" Version="8.5.0" />
    <!-- MailKit = real SMTP email delivery. QuestPDF = real PDF invoice rendering. -->
    <PackageReference Include="MailKit" Version="4.13.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
